#!/usr/bin/env python3
"""Start official Glance on 127.0.0.1 and proxy /var/api/glance.sock."""

from __future__ import annotations

import os
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

from tos_unix_proxy import serve_proxy

APP_ID = "glance"
APP_DIR = Path("/usr/local/glance")
UPSTREAM = Path(os.environ.get("GLANCE_BIN") or APP_DIR / "bin" / "glance")
DEFAULT_CONFIG = APP_DIR / "conf" / "glance.yml"
CONFIG = Path(os.environ.get("GLANCE_CONFIG") or APP_DIR / "data" / "glance.yml")
SOCKET_PATH = os.environ.get("APP_SOCKET_PATH") or f"/var/api/{APP_ID}.sock"
LISTEN = os.environ.get("GLANCE_LISTEN") or "127.0.0.1"
PORT = int(os.environ.get("GLANCE_PORT") or "18741")
PROXY_PREFIX = f"/v2/proxy/{APP_ID}"
BASE_URL = os.environ.get("GLANCE_BASE_URL") or PROXY_PREFIX


def log(level: str, message: str) -> None:
    print(f"[{APP_ID}] [{level}] {message}", flush=True)


def ensure_layout() -> None:
    for path in (APP_DIR / "data", APP_DIR / "logs"):
        path.mkdir(parents=True, exist_ok=True)
    if not CONFIG.exists():
        if not DEFAULT_CONFIG.is_file():
            raise SystemExit(f"default config missing: {DEFAULT_CONFIG}")
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(DEFAULT_CONFIG, CONFIG)
        log("INFO", f"installed default config at {CONFIG}")


def wait_for_port(
    host: str,
    port: int,
    timeout: float = 90.0,
    stop_event: threading.Event | None = None,
) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if stop_event is not None and stop_event.is_set():
            return False
        try:
            with socket.create_connection((host, port), timeout=0.4):
                return True
        except OSError:
            if stop_event is not None:
                if stop_event.wait(0.1):
                    return False
            else:
                time.sleep(0.1)
    return False


def main() -> int:
    os.environ.setdefault("GLANCE_LISTEN", LISTEN)
    os.environ.setdefault("GLANCE_PORT", str(PORT))
    os.environ.setdefault("GLANCE_BASE_URL", BASE_URL)
    ensure_layout()
    if not UPSTREAM.is_file():
        raise SystemExit(f"upstream binary missing: {UPSTREAM}")
    proc = subprocess.Popen(
        [str(UPSTREAM), "-config", str(CONFIG)],
        cwd=str(APP_DIR),
        env=os.environ.copy(),
    )

    stop_event = threading.Event()

    def request_shutdown(signum=None, _frame=None) -> None:
        log("INFO", f"received signal {signum}; stopping")
        stop_event.set()

    signal.signal(signal.SIGTERM, request_shutdown)
    signal.signal(signal.SIGINT, request_shutdown)

    def shutdown() -> None:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                log("WARNING", "Glance ignored SIGTERM; sending SIGKILL")
                proc.kill()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    log("ERROR", "Glance did not exit after SIGKILL")

    try:
        if proc.poll() is not None:
            log("ERROR", f"Glance exited immediately with {proc.returncode}")
            return proc.returncode or 1
        log("INFO", f"waiting for Glance to listen (up to 90s)")
        if not wait_for_port(LISTEN, PORT, stop_event=stop_event):
            if stop_event.is_set():
                log("INFO", "shutdown requested before startup completed")
                return 0
            raise SystemExit(f"Glance did not listen on {LISTEN}:{PORT} within 90s")
        log("INFO", f"Glance is listening on {LISTEN}:{PORT}")
        # Glance runs in proxied mode: it serves from the upstream root and
        # only uses server.base-url to generate URLs. The platform socket
        # route always carries the /v2/proxy/<appid> prefix, so strip that
        # (not BASE_URL) before forwarding.
        return serve_proxy(
            SOCKET_PATH,
            LISTEN,
            PORT,
            strip_prefix=PROXY_PREFIX,
            socket_mode=0o660,
            stop_event=stop_event,
        )
    finally:
        shutdown()
        if os.path.lexists(SOCKET_PATH):
            try:
                os.unlink(SOCKET_PATH)
            except OSError:
                pass


if __name__ == "__main__":
    raise SystemExit(main())
